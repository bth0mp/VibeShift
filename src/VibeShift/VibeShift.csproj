<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- WPF and WinForms (tray only) share type names; keep usings explicit -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- PerMonitorV2 in app.manifest is for WPF; WinForms only supplies the tray icon -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>VibeShift</Product>
    <Description>One click from vibe coding to gaming, and back.</Description>
    <Copyright>Copyright (c) 2026 bth0mp</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>..\..\assets\VibeShift.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- window + tray icon, loaded as pack://application:,,,/VibeShift.ico -->
    <Resource Include="..\..\assets\VibeShift.ico" Link="VibeShift.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibeShift.Core\VibeShift.Core.csproj" />
  </ItemGroup>

</Project>
