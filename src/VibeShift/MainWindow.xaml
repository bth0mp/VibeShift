<Window x:Class="VibeShift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeShift" Width="480" Height="600"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" Icon="pack://application:,,,/VibeShift.ico">
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Icon rail -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                <RadioButton x:Name="HomeTab" Style="{StaticResource RailButton}" GroupName="Rail" IsChecked="True" Content="&#xE80F;" ToolTip="Home" AutomationProperties.Name="Home" />
                <RadioButton x:Name="VibeTab" Style="{StaticResource RailButton}" GroupName="Rail" Content="&#xE945;" ToolTip="Vibe" AutomationProperties.Name="Vibe" />
                <RadioButton x:Name="AppsTab" Style="{StaticResource RailButton}" GroupName="Rail" Content="&#xE71D;" ToolTip="Apps" AutomationProperties.Name="Apps" />
                <RadioButton x:Name="SettingsTab" Style="{StaticResource RailButton}" GroupName="Rail" Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings" />
            </StackPanel>
        </Border>

        <!-- Home -->
        <Grid x:Name="HomePage" Grid.Column="1" Margin="18,16,18,18"
              Visibility="{Binding IsChecked, ElementName=HomeTab, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding UpdateText}" Command="{Binding UpdateCommand}"
                        VerticalAlignment="Center" IsEnabled="{Binding CanCheckUpdates}" Visibility="{Binding HasUpdate, Converter={StaticResource Visible}}"
                        ToolTip="Downloads the new version from GitHub and restarts VibeShift" />
                <Ellipse Width="9" Height="9" Margin="0,2,10,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource CodingDotBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGaming}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource GamingDotBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ModeText}" FontSize="18" FontWeight="SemiBold" />
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="3" Margin="-4,14,-4,16">
                <Border Style="{StaticResource Tile}" Margin="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="FREE RAM" />
                        <TextBlock Text="{Binding FreeRamText}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="AI APPS" />
                        <TextBlock Text="{Binding AppsText}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding ThirdLabel}" />
                        <TextBlock Text="{Binding ThirdValue}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{DynamicResource HighlightBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <DockPanel Grid.Row="2" Margin="0,0,0,7">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ Add app" Click="AddApp_Click"
                        Visibility="{Binding IsCoding, Converter={StaticResource Visible}}" />
                <TextBlock Style="{StaticResource Label}" Text="{Binding ListTitle}" />
            </DockPanel>

            <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ItemsControl x:Name="HomeList" ItemsSource="{Binding HomeRows}" Margin="0,-1,0,0" ItemTemplate="{DynamicResource RowTemplate}" />
                        <TextBlock Text="No AI apps are running right now." Foreground="{DynamicResource MutedBrush}" Margin="14,14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HomeRows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="4" Margin="0,16,0,0">
                <!-- While gaming: the game VibeShift sees (and will switch back after), with a way out for false matches -->
                <DockPanel Margin="2,0,2,10" Visibility="{Binding IsPlaying, Converter={StaticResource Visible}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Not a game" Command="{Binding NotAGameCommand}"
                            ToolTip="VibeShift will stop treating this as a game"
                            AutomationProperties.Name="{Binding PlayingText, StringFormat='{}{0}: not a game'}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding PlayingText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Grid>
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}"
                            IsEnabled="{Binding CanVibeAct}" Visibility="{Binding IsCoding, Converter={StaticResource Visible}}" />
                    <Button Style="{StaticResource GhostButton}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}"
                            IsEnabled="{Binding CanVibeAct}" Visibility="{Binding IsGaming, Converter={StaticResource Visible}}" />
                </Grid>
                <!-- One click to in-game: switch to gaming mode, then launch the game -->
                <Button Style="{StaticResource SoftButton}" Content="{Binding PlayText}" Command="{Binding PlayCommand}" Margin="0,8,0,0"
                        IsEnabled="{Binding IsIdle}" Visibility="{Binding CanPlay, Converter={StaticResource Visible}}"
                        ToolTip="Closes your apps for gaming, then starts the game (Ctrl+Alt+P)" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding StatsText}" HorizontalAlignment="Center" Margin="0,10,0,0"
                           Visibility="{Binding HasStats, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Grid>

        <!-- Vibe: live on/off for AI apps -->
        <Grid Grid.Column="1" Margin="18,16,18,18"
              Visibility="{Binding IsChecked, ElementName=VibeTab, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Margin="0,2,10,0" VerticalAlignment="Center" Fill="{DynamicResource CodingDotBrush}" />
                <TextBlock Text="Vibe mode" FontSize="18" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Grid.Row="1" Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,14"
                       Text="Flip an app on to open it, off to close it, right now. This doesn't switch modes." />
            <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,16">
                <Button Style="{StaticResource PrimaryButton}" Content="Open all" Margin="0,0,5,0" Height="42"
                        Command="{Binding OpenAllCommand}" IsEnabled="{Binding CanVibeAct}" />
                <Button Style="{StaticResource GhostButton}" Content="Close all" Margin="5,0,0,0" Height="42"
                        Command="{Binding CloseAllCommand}" IsEnabled="{Binding CanVibeAct}" />
            </UniformGrid>
            <DockPanel Grid.Row="3" Margin="0,0,0,7">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ Add" Click="AddVibeApp_Click" />
                <TextBlock Style="{StaticResource Label}" Text="YOUR AI APPS" />
            </DockPanel>
            <Border Grid.Row="4" Style="{StaticResource Card}" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding VibeRows}" Margin="0,-1,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOpen}"
                                                      IsEnabled="{Binding CanSwitch}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='{}{0} open'}"
                                                      AutomationProperties.HelpText="{Binding Status}" />
                                            <Border Width="22" Height="22" CornerRadius="6" Background="{Binding BadgeBrush}">
                                                <TextBlock Text="{Binding BadgeLetter}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="10,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Status}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunningStatus}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource RunningTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="14,14"
                                   Text="No AI apps yet. Open one once and VibeShift will remember it, or use + Add for any app."
                                   Visibility="{Binding HasVibeRows, Converter={StaticResource Hidden}}" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Apps -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsChecked, ElementName=AppsTab, Converter={StaticResource Visible}}">
            <StackPanel Margin="18,16,18,18">
                <TextBlock Text="Apps" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,16"
                           Text="Close: closed when you start gaming. Game: opened when you start gaming. Vibe: opened when you're back to vibe coding. An app shows up here once VibeShift has seen it running, or when you add it yourself." />
                <DockPanel Margin="0,0,0,7">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ Add app" Click="AddApp_Click" />
                    <TextBlock Style="{StaticResource Label}" Text="YOUR APPS" />
                </DockPanel>
                <!-- column headings over the three switches in each row -->
                <Grid Margin="12,0,12,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource Label}" FontSize="9" Text="CLOSE" HorizontalAlignment="Center"
                               ToolTip="Close when you start gaming" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Label}" FontSize="9" Text="GAME" HorizontalAlignment="Center"
                               ToolTip="Open when you start gaming (Discord, OBS...)" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Label}" FontSize="9" Text="VIBE" HorizontalAlignment="Center"
                               ToolTip="Open when you switch back to vibe coding" />
                </Grid>
                <TextBlock Text="{Binding AppsMessage}" Foreground="{DynamicResource HighlightBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding HasAppsMessage, Converter={StaticResource Visible}}" />
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding AllRows}" Margin="0,-1,0,0" ItemTemplate="{DynamicResource AppsRowTemplate}" />
                </Border>

                <StackPanel Visibility="{Binding HasSuggestions, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Label}" Text="USING THE MOST RAM" Margin="0,20,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Other apps using a lot of memory right now. Add one and Gaming mode will close it too." />
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,-1,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,9" ToolTip="{Binding Path}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ Add" Click="AddSuggestion_Click"
                                                    VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat='Add {0}'}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Border Width="22" Height="22" CornerRadius="6" Background="{Binding BadgeBrush}" Opacity="0.75">
                                                <TextBlock Text="{Binding BadgeLetter}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsChecked, ElementName=SettingsTab, Converter={StaticResource Visible}}">
            <StackPanel Margin="18,16,18,18">
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />

                <TextBlock Style="{StaticResource Label}" Text="APPEARANCE" Margin="0,18,0,7" />
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" ItemsSource="{Binding ThemeOptions}"
                                 DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Theme}"
                                 AutomationProperties.Name="Theme" />
                        <TextBlock Text="Theme" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <TextBlock Style="{StaticResource Label}" Text="AUTOMATIC SWITCHING" Margin="0,18,0,7" />
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoMode}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Auto mode" />
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Auto mode" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                           Text="Switch to gaming when a game starts, and back 10 seconds after it closes." />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,11" />
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ReturnWhenGameCloses}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Switch back when my game closes" />
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Switch back when my game closes" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                           Text="Even if you started gaming yourself: about 10 seconds after your game closes, VibeShift switches back and opens your apps." />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,11" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ Add game" Click="AddGame_Click" />
                            <TextBlock Style="{StaticResource Label}" Text="MY GAMES" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,4"
                                   Text="Steam, Epic, GOG, EA and Xbox games are found automatically. Add anything else here." />
                        <ItemsControl ItemsSource="{Binding MyGames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Click="RemoveGame_Click"
                                                ToolTip="Remove" AutomationProperties.Name="{Binding StringFormat='Remove {0}'}" />
                                        <TextBlock Text="{Binding}" ToolTip="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding HasNotGames, Converter={StaticResource Visible}}">
                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,11" />
                            <TextBlock Style="{StaticResource Label}" Text="NOT GAMES" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,4"
                                       Text="You said these aren't games, so VibeShift ignores them. Remove one to have it detected again." />
                            <ItemsControl ItemsSource="{Binding NotGames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3,0,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Click="RemoveNotGame_Click"
                                                    ToolTip="Remove" AutomationProperties.Name="{Binding StringFormat='Remove {0}'}" />
                                            <TextBlock Text="{Binding}" ToolTip="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Label}" Text="CLOSING APPS" Margin="0,18,0,7" />
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Force-close after" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,9"
                                   Text="When you click Start gaming, apps get this long to close on their own. Auto mode closes them right away." />
                        <ListBox Style="{StaticResource Segmented}" HorizontalAlignment="Left" ItemsSource="{Binding ForceCloseOptions}"
                                 ItemStringFormat="{}{0} s" SelectedItem="{Binding ForceCloseSeconds}"
                                 AutomationProperties.Name="Force-close after" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Label}" Text="POWER PLAN" Margin="0,18,0,7" />
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="Switch to this power plan while you game, and back to the one you had afterwards." />
                        <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding PowerPlanOptions}" DisplayMemberPath="Name"
                                 SelectedValuePath="Id" SelectedValue="{Binding GamingPowerPlan}" AutomationProperties.Name="Power plan while gaming" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Label}" Text="PLAY BUTTON" Margin="0,18,0,7" />
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="The game the Play button (and Ctrl+Alt+P) starts, after closing your apps for gaming. Your most recently played game is picked until you choose one." />
                        <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding Games}" DisplayMemberPath="Name"
                                 SelectedValuePath="Id" SelectedValue="{Binding PlayGameId}" AutomationProperties.Name="Play button game" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Label}" Text="KEYBOARD SHORTCUTS" Margin="0,18,0,7" />
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Hotkeys}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Keyboard shortcuts" />
                            <TextBlock Text="Shortcuts that work from anywhere, even mid-game" Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <Grid Margin="0,10,0,0" TextElement.FontSize="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Pill}" Margin="0,2,10,2"><TextBlock Text="Ctrl+Alt+G" FontSize="11" /></Border>
                            <TextBlock Grid.Column="1" Text="Start gaming / back to vibe coding" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <Border Grid.Row="1" Style="{StaticResource Pill}" Margin="0,2,10,2"><TextBlock Text="Ctrl+Alt+V" FontSize="11" /></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Open all AI apps" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <Border Grid.Row="2" Style="{StaticResource Pill}" Margin="0,2,10,2"><TextBlock Text="Ctrl+Alt+P" FontSize="11" /></Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Play your game" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding HotkeyStatus}" Foreground="{DynamicResource HighlightBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasHotkeyStatus, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Label}" Text="STARTUP" Margin="0,18,0,7" />
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Start with Windows" />
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Start with Windows" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="Starts quietly in the tray, by the clock." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Style="{StaticResource Label}" Text="EXTRA BOOST" Margin="0,18,0,7" />
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ExtraBoost}" VerticalAlignment="Top" Margin="0,2,0,0"
                                  AutomationProperties.Name="Extra boost" />
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Extra boost" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0">
                                <Run Text="Also pauses Windows background services (" /><Run Text="{Binding BoostServicesText, Mode=OneWay}" /><Run
                                     Text=") while you game. Windows asks for admin permission when you click Start gaming and again when you switch back. Auto mode skips this, so nothing pops up over your game." />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Style="{StaticResource Label}" Text="ABOUT" Margin="0,18,0,7" />
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Check for updates" Command="{Binding CheckUpdatesCommand}"
                                    VerticalAlignment="Center" IsEnabled="{Binding CanCheckUpdates}" />
                            <TextBlock Text="{Binding Version}" />
                        </DockPanel>
                        <TextBlock Margin="0,3,0,0" FontSize="12">
                            <Hyperlink NavigateUri="https://github.com/bth0mp/VibeShift" RequestNavigate="Link_RequestNavigate"
                                       Foreground="{DynamicResource HighlightBrush}">github.com/bth0mp/VibeShift</Hyperlink>
                        </TextBlock>
                        <DockPanel Margin="0,8,0,0" Visibility="{Binding HasUpdateStatus, Converter={StaticResource Visible}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding UpdateText}" Command="{Binding UpdateCommand}"
                                    VerticalAlignment="Center" IsEnabled="{Binding CanCheckUpdates}" Visibility="{Binding HasUpdate, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource HighlightBrush}" TextWrapping="Wrap" Margin="0,0,10,0" />
                        </DockPanel>
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,11" />
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CheckForUpdates}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Check for updates automatically" />
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Check for updates automatically" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                           Text="Once a day, VibeShift asks GitHub whether there's a newer version. It never updates without your click." />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,11,0,0" Text="MIT License. Nothing leaves your PC except update checks." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <Window.Resources>
        <!-- One app row: badge, name, RAM or tag, toggle -->
        <DataTemplate x:Key="RowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,9" Background="Transparent" ToolTip="{Binding Tooltip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Badge" Width="22" Height="22" CornerRadius="6" Background="{Binding BadgeBrush}">
                        <TextBlock Text="{Binding BadgeLetter}" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="AppName" Grid.Column="1" Text="{Binding Name}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding RamText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                               Visibility="{Binding ShowRam, Converter={StaticResource Visible}}" />
                    <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center"
                            Visibility="{Binding HasTag, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Tag}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
                    </Border>
                    <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn}" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Name, StringFormat='Close {0} when gaming'}"
                              Visibility="{Binding ShowToggle, Converter={StaticResource Visible}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="Badge" Property="Opacity" Value="0.45" />
                    <Setter TargetName="AppName" Property="Opacity" Value="0.6" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Apps page row: toggle always shown, remove button on apps the user added -->
        <DataTemplate x:Key="AppsRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,9" Background="Transparent" ToolTip="{Binding Tooltip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="6" Background="{Binding BadgeBrush}">
                        <TextBlock Text="{Binding BadgeLetter}" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding RamText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                               Visibility="{Binding ShowRam, Converter={StaticResource Visible}}" />
                    <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center" Margin="0,0,6,0"
                            Visibility="{Binding HasTag, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Tag}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
                    </Border>
                    <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn}" VerticalAlignment="Center" HorizontalAlignment="Center"
                              ToolTip="Close when you start gaming" AutomationProperties.Name="{Binding Name, StringFormat='Close {0} when gaming'}" />
                    <CheckBox Grid.Column="4" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsGame}" VerticalAlignment="Center" HorizontalAlignment="Center"
                              ToolTip="Open when you start gaming (and never close it for gaming)"
                              AutomationProperties.Name="{Binding Name, StringFormat='Open {0} when gaming'}"
                              Visibility="{Binding CanVibe, Converter={StaticResource Visible}}" />
                    <CheckBox Grid.Column="5" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsVibe}" VerticalAlignment="Center" HorizontalAlignment="Center"
                              ToolTip="Open every time you switch back to vibe coding, even if it wasn't open before"
                              AutomationProperties.Name="{Binding Name, StringFormat='Open {0} when vibing'}"
                              Visibility="{Binding CanVibe, Converter={StaticResource Visible}}" />
                    <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="&#xE711;" Width="22" Click="RemoveApp_Click"
                            ToolTip="Remove" AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}"
                            Visibility="{Binding IsCustom, Converter={StaticResource Visible}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
</Window>
