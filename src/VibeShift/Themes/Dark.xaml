<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#0f0d15</Color>
    <Color x:Key="TextColor">#ede9fe</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#0f0d15" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1a1724" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#221e2f" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2c2740" />
    <SolidColorBrush x:Key="TextBrush" Color="#ede9fe" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9c94b3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8b5cf6" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#c084fc" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#3a3550" />
    <SolidColorBrush x:Key="CodingDotBrush" Color="#34d399" />
    <SolidColorBrush x:Key="GamingDotBrush" Color="#a855f7" />
    <LinearGradientBrush x:Key="ButtonGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7c3aed" Offset="0" />
        <GradientStop Color="#a855f7" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
