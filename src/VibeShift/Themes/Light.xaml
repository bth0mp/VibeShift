<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#f7f5fc</Color>
    <Color x:Key="TextColor">#1e1631</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#f7f5fc" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#f1edfb" />
    <SolidColorBrush x:Key="BorderBrush" Color="#e4ddf5" />
    <SolidColorBrush x:Key="TextBrush" Color="#1e1631" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6b6385" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7c3aed" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#7c3aed" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#d6cfe8" />
    <SolidColorBrush x:Key="CodingDotBrush" Color="#34d399" />
    <SolidColorBrush x:Key="GamingDotBrush" Color="#a855f7" />
    <LinearGradientBrush x:Key="ButtonGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7c3aed" Offset="0" />
        <GradientStop Color="#a855f7" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
