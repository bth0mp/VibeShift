<Window x:Class="VibeShift.QuitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quit VibeShift" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" Icon="pack://application:,,,/VibeShift.ico">
    <Border Background="{DynamicResource BgBrush}" Padding="20,16,20,20">
    <StackPanel>
        <TextBlock Text="Reopen your apps first?" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="Body" Margin="0,6,0,18" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
        <Button x:Name="ReopenButton" Style="{StaticResource PrimaryButton}" Content="Reopen and quit" Height="42" IsDefault="True" Click="Reopen_Click" />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource SoftButton}" Content="Quit anyway" Margin="0,0,5,0" Click="Quit_Click" />
            <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="Cancel" Margin="5,0,0,0" IsCancel="True" />
        </Grid>
    </StackPanel>
    </Border>
</Window>
